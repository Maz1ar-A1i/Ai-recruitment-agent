# AI Recruitment Agent Environment Configuration

# LLM Provider: "gemini", "openai", or "mock" (offline fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database Connection (SQLite default)
DATABASE_URL=sqlite:///./recruitment.db

# Agent Workflow Settings
MAX_AGENT_STEPS=12
MAX_FILE_SIZE_MB=10

# Scoring Model Weights (Must sum to 1.0)
WEIGHT_SKILLS=0.50
WEIGHT_EXPERIENCE=0.20
WEIGHT_EDUCATION=0.10
WEIGHT_PREFERRED_SKILLS=0.10
WEIGHT_PROJECTS=0.10

# Recommendation Thresholds (out of 100)
THRESHOLD_STRONG_MATCH=85
THRESHOLD_MATCH=70
THRESHOLD_POTENTIAL_MATCH=50
